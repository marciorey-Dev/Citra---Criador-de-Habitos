<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habits_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_widget_fire" />

        <TextView
            android:id="@+id/widget_habits_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Hábitos de Hoje"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_habits_streak_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="0/0"
            android:textColor="#FF9E40"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#3B3732"
        android:importantForAccessibility="no" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/widget_habits_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Nenhum hábito para hoje. Toque para criar!"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Container for Habit Rows -->
    <LinearLayout
        android:id="@+id/widget_habits_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Habit Row 1 -->
        <LinearLayout
            android:id="@+id/habit_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="3dp"
            android:background="@drawable/widget_bg_secondary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/habit_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hábito 1"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/habit_streak_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="🔥 3d"
                android:textColor="#FF9E40"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/habit_check_1"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Check in"
                android:src="@drawable/ic_widget_check_off" />
        </LinearLayout>

        <!-- Habit Row 2 -->
        <LinearLayout
            android:id="@+id/habit_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="3dp"
            android:background="@drawable/widget_bg_secondary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/habit_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hábito 2"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/habit_streak_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="🔥 0d"
                android:textColor="#FF9E40"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/habit_check_2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Check in"
                android:src="@drawable/ic_widget_check_off" />
        </LinearLayout>

        <!-- Habit Row 3 -->
        <LinearLayout
            android:id="@+id/habit_row_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="3dp"
            android:background="@drawable/widget_bg_secondary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/habit_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hábito 3"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/habit_streak_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="🔥 1d"
                android:textColor="#FF9E40"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/habit_check_3"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Check in"
                android:src="@drawable/ic_widget_check_off" />
        </LinearLayout>

        <!-- Habit Row 4 -->
        <LinearLayout
            android:id="@+id/habit_row_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_secondary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/habit_title_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hábito 4"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/habit_streak_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="🔥 5d"
                android:textColor="#FF9E40"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/habit_check_4"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Check in"
                android:src="@drawable/ic_widget_check_off" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
