{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with gamification stats and privacy flags",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "isDev": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "totalFocusMinutes": { "type": "number" },
        "completedTasksCount": { "type": "number" },
        "completedHabitsCount": { "type": "number" },
        "achievementsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "username"]
    },
    "CloudSyncDoc": {
      "title": "CloudSyncDoc",
      "description": "Cloud backup document for user data, notes, settings, and finances",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "backupJson": { "type": "string" },
        "notesJson": { "type": "string" },
        "settings": { "type": "object" },
        "financesJson": { "type": "string" },
        "syncedAt": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "InboxMessage": {
      "title": "InboxMessage",
      "description": "Direct note share, broadcast announcement, or bug report notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderDisplayName": { "type": "string" },
        "senderUsername": { "type": "string" },
        "senderPhotoUrl": { "type": "string" },
        "senderEmail": { "type": "string" },
        "recipientUid": { "type": "string" },
        "recipientDisplayName": { "type": "string" },
        "recipientUsername": { "type": "string" },
        "recipientPhotoUrl": { "type": "string" },
        "isOfficialDev": { "type": "boolean" },
        "title": { "type": "string" },
        "contentMarkdown": { "type": "string" },
        "category": { "type": "string" },
        "sentAtMillis": { "type": "number" },
        "isRead": { "type": "boolean" },
        "isDownloaded": { "type": "boolean" },
        "isBroadcast": { "type": "boolean" },
        "isBugReport": { "type": "boolean" }
      },
      "required": ["id", "senderUid", "title", "contentMarkdown", "sentAtMillis"]
    },
    "RecipientLookup": {
      "title": "RecipientLookup",
      "description": "Public recipient index entry keyed by SHA-256 hash without exposing PII",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "photoUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "username"]
    },
    "BugReport": {
      "title": "BugReport",
      "description": "User-submitted bug report for developer triage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterUid": { "type": "string" },
        "reporterDisplayName": { "type": "string" },
        "reporterUsername": { "type": "string" },
        "reporterEmail": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "appVersion": { "type": "string" },
        "deviceModel": { "type": "string" },
        "createdAtMillis": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "reporterUid", "title", "description", "createdAtMillis", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Owner-isolated user profile document"
    },
    "/users/{userId}/cloudSync/{docId}": {
      "schema": { "$ref": "#/entities/CloudSyncDoc" },
      "description": "User cloud backup payloads (current, finances)"
    },
    "/users/{userId}/inbox/{messageId}": {
      "schema": { "$ref": "#/entities/InboxMessage" },
      "description": "User received inbox messages"
    },
    "/users/{userId}/sent/{messageId}": {
      "schema": { "$ref": "#/entities/InboxMessage" },
      "description": "User sent inbox messages"
    },
    "/usernameLookup/{lookupId}": {
      "schema": { "$ref": "#/entities/RecipientLookup" },
      "description": "Hashed @username lookup index for direct note sharing"
    },
    "/displayNameLookup/{lookupId}": {
      "schema": { "$ref": "#/entities/RecipientLookup" },
      "description": "Hashed displayName lookup index for direct note sharing"
    },
    "/emailLookup/{lookupId}": {
      "schema": { "$ref": "#/entities/RecipientLookup" },
      "description": "Hashed email lookup index for direct note sharing"
    },
    "/broadcasts/{broadcastId}": {
      "schema": { "$ref": "#/entities/InboxMessage" },
      "description": "Official developer broadcast announcements"
    },
    "/bugReports/{reportId}": {
      "schema": { "$ref": "#/entities/BugReport" },
      "description": "Authenticated user bug reports"
    }
  }
}
