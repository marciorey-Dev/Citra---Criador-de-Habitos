rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDeveloper() {
      return isAuthenticated() && (
        request.auth.token.email in ['obitoinfamous@gmail.com', 'obitoinfamous5@gmail.com', 'marcioafonsorey@gmail.com', 'marcioreyakm@gmail.com', 'marcioreyakm@gmail.co']
      );
    }

    // User profile: readable by authenticated users to allow @username search, writable by owner or developer
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write, delete: if isOwner(userId) || isDeveloper();

      // User private subcollections
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId) || isDeveloper();
      }

      match /habits/{habitId} {
        allow read, write: if isOwner(userId) || isDeveloper();
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(userId) || isDeveloper();
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId) || isDeveloper();
      }

      match /cloudSync/{docId} {
        allow read, write, delete: if isOwner(userId) || isDeveloper();
      }

      match /inbox/{messageId} {
        allow read, update, delete: if isOwner(userId) || isDeveloper();
        allow create: if isAuthenticated();
      }

      match /sent/{messageId} {
        allow read, write, delete: if isOwner(userId) || isDeveloper();
      }
    }

    // Global developer announcements / broadcasts
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow write: if isDeveloper();
    }

    // Bug reports sent by authenticated users to app developers
    match /bugReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isDeveloper();
    }
  }
}
