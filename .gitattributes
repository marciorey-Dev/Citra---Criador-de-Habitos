# Force LF line endings for Unix scripts, Gradle configs, and CI files so GitHub Actions always succeeds
gradlew text eol=lf
gradlew.bat text eol=crlf
*.sh text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
debug.keystore.base64 text eol=lf
